{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "allowImportingTsExtensions": true, "noEmit": true,
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "isolatedModules": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "types": ["node", "vite/client"],
    "noUnusedLocals": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
