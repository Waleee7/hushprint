{
  "name": "hushprint",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hushprint: see what hidden data your photos, PDFs, Office files and videos leak (GPS, author names, serial numbers, hidden thumbnails), then strip it. 100% in-browser, offline, zero uploads, hand-written parsers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:landmask": "node scripts/gen-landmask.mjs",
    "cli": "node bin/hushprint.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "keywords": [
    "privacy",
    "exif",
    "metadata",
    "gps",
    "photo-privacy",
    "exif-remover",
    "metadata-stripper",
    "jpeg",
    "png",
    "xmp",
    "security",
    "client-side",
    "offline",
    "local-first",
    "typescript",
    "react",
    "vite",
    "csp",
    "osint",
    "aCropalypse",
    "webp",
    "heic",
    "pdf",
    "docx",
    "pwa",
    "cli",
    "mp4",
    "privacy-score"
  ],
  "license": "MIT",
  "bin": {
    "hushprint": "bin/hushprint.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
